// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  charset  = "utf8mb4"
}


model cliente {
  id           BigInt     @id @default(autoincrement())
  nombres      String     @db.VarChar(60)
  apellidos    String     @db.VarChar(60)
  celular      String     @db.VarChar(20)
  direccion    String?    @db.VarChar(120)
  dni          String     @unique @db.VarChar(15)
  fecha_nac    DateTime?  @db.Date
  vetado       Boolean    @default(false)
  motivo_veto  String?    @db.VarChar(200)
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamp(0)
  deleted_at   DateTime?  @db.Timestamp(0)

  @@index([nombres])
  @@index([apellidos])
  @@index([celular])
}
